{
  "name": "cattimer",
  "version": "1.0.7",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac dir",
    "build:win": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@38.8.6": true
  },
  "build": {
    "appId": "local.cattimer",
    "productName": "CatTimer",
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "selfupdate.js",
      "index.html"
    ],
    "extraResources": [
      {
        "from": "photos",
        "to": "photos"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "identity": null
    },
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "${productName}-Windows-Portable-${version}.exe"
    }
  }
}